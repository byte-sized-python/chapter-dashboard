# --- Access control -------------------------------------------------------
# Comma-separated. These emails are HQ Admins. This is the ONLY way to become
# an HQ Admin; nothing about HQ admin status is stored in Firestore.
HQ_ADMIN_EMAILS=tduba@bytesizedpython.org

# Access is granted purely on email, so unverified emails are rejected by
# default. Only set this if your Auth0 connection can't mark emails verified.
# ALLOW_UNVERIFIED_EMAILS=false

# --- Auth0 ----------------------------------------------------------------
AUTH0_DOMAIN=auth.bytesizedpython.org
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
# Omit on Vercel preview deployments to infer the host at runtime.
APP_BASE_URL=http://localhost:3000

# --- Firestore ------------------------------------------------------------
FIREBASE_PROJECT_ID=
# The service account JSON, either inline or base64-encoded. Omit to fall back
# to Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY=
